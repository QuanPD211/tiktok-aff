<%
  const s = settings;
  const layout = ['center', 'fullscreen', 'bottom'].includes(s.popup_layout) ? s.popup_layout : 'center';
  const brand = s.popup_brand || s.site_name;
  const isPreview = typeof preview !== 'undefined' && preview;
%>
<div class="ad ad--<%= layout %><%= isPreview ? ' is-open' : '' %>" <%= isPreview ? '' : 'id=ad-popup hidden' %>>
  <div class="ad__backdrop"></div>
  <div class="ad__dialog" role="dialog" aria-label="Quảng cáo">
    <div class="ad__top">
      <span class="ad__label">Quảng cáo</span>
      <button type="button" class="ad__close" aria-label="Đóng">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="ad__media">
      <% if (s.popup_image) { %>
        <img src="<%= s.popup_image %>" alt="">
      <% } else { %>
        <div class="ad__placeholder"><span><%= brand.charAt(0).toUpperCase() %></span></div>
      <% } %>
      <% if (s.popup_badge) { %><span class="ad__badge"><%= s.popup_badge %></span><% } %>
    </div>
    <div class="ad__body">
      <div class="ad__brand">
        <span class="ad__avatar"><%= brand.charAt(0).toUpperCase() %></span>
        <div>
          <strong><%= brand %></strong>
          <small>Được tài trợ</small>
        </div>
      </div>
      <% if (s.popup_title) { %><h3 class="ad__title"><%= s.popup_title %></h3><% } %>
      <% if (s.popup_text) { %><p class="ad__text"><%= s.popup_text %></p><% } %>
      <span class="ad__cta">
        <%= s.popup_button || 'Xem ngay' %>
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </div>
  </div>
</div>
